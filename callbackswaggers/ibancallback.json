{
  "openapi": "3.0.0",
  "info": {
    "title": "IBAN Verification",
    "description": "Callback endpoint required to receive inquired IBAN Verification Details from requested sources\nAlso You can inquire on the Verificatin Request seperatly.\n",
    "version": "1.0.0",
    "x-ibm-name": "iban-verification"
  },
  "servers": [
    {
      "url": "/iban-verification/v1"
    }
  ],
  "tags": [
    {
      "name": "IBAN Verification Callback",
      "description": "EndPOInts required for receiving IBAN Verifiaction for a specific request."
    }
  ],
  "paths": {
    "/verification-requets/push": {
      "post": {
        "tags": [
          "IBAN Verification Callback"
        ],
        "summary": "Recieve IBAN Verefication Data from all required sources for a specific Request.",
        "operationId": "CallbackVerificationRequest",
        "description": "Returns IBAN Verefication Data from all required sources for a specific Request.",
        "parameters": [
          {
            "$ref": "#/components/parameters/x-request-id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationRequestCallbackBody"
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/202VerificationRequestCallbackResponse"
          },
          "500": {
            "$ref": "#/components/responses/500Error"
          }
        }
      }
    }
  },
  "components": {
