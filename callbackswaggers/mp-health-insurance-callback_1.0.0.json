{
  "openapi": "3.0.3",
  "info": {
    "title": "MP Policy Callback API",
    "version": "1.0.0"
  },
  "security": [
    {
      "OAuth2Security": [
        "marketplace_apis"
      ]
    }
  ],
  "paths": {
    "/policy/cchi-status": {
      "post": {
        "summary": "Submit policy and member CCHI status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2Security": {
        "type": "oauth2",
        "description": "OAuth2 Client Credentials flow. It is required when client requests access to service APIs.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api-marketplace.alrajhigroup.com.sa/oauth2security/oauth2/token",
            "scopes": {
              "marketplace_apis": "Marketplace service APIs operations access"
            }
          }
        }
      }
    },
    "schemas": {
      "PolicyRequest": {
        "type": "object",
        "required": [
          "PolicyRequestReferenceNumber",
          "PolicyReferenceNumber",
          "Details",
          "QuoteRequestSourceID"
        ],
        "properties": {
          "PolicyRequestReferenceNumber": {
            "type": "string",
            "description": "Unique identifier generated by ARB for the policy request"
          },
          "PolicyReferenceNumber": {
            "type": "string",
            "description": "Reference number of the issued policy"
          },
          "QuoteRequestSourceID": {
            "type": "integer",
            "description": "Identifier for the source system.Will be the same that you pass in create quote request"
          },
          "Details": {
            "type": "object",
            "required": [
              "PolicyNumber",
              "PolicyEffectiveDate",
              "PolicyExpiryDate",
              "CCHIStatus",
              "MembershipNumbers"
            ],
            "properties": {
              "PolicyNumber": {
                "type": "string",
                "description": "Policy Number generated by IC"
              },
              "PolicyEffectiveDate": {
                "type": "string",
                "format": "date",
                "description": "Start date of the policy (YYYY-MM-DD)"
              },
              "PolicyExpiryDate": {
                "type": "string",
                "format": "date",
                "description": "Expiry date of the policy (YYYY-MM-DD)"
              },
              "CCHIStatus": {
                "type": "integer",
                "description": "Policy-level CCHI status (1 = Pass, 2 = Rejected)"
              },
              "MembershipNumbers": {
                "type": "array",
                "description": "List of members under the policy",
                "items": {
                  "type": "object",
                  "required": [
                    "MemberID",
                    "MembershipNumber",
                    "MemberCCHIStatus"
                  ],
                  "properties": {
                    "MemberID": {
                      "type": "string",
                      "description": "National Id of member"
                    },
                    "MembershipNumber": {
                      "type": "string",
                      "description": "Member's policy membership number"
                    },
                    "MemberCCHIStatus": {
                      "type": "integer",
                      "description": "CCHI status for the member (1 = Pass, 2 = Rejected)"
                    },
                    "MemberCCHIStatusError": {
                      "type": "string",
                      "description": "Error message if status is not 1"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PolicyResponse": {
        "type": "object",
        "required": [
          "Status"
        ],
        "properties": {
          "Status": {
            "type": "boolean",
            "description": "Indicates success or failure of the request"
          },
          "errors": {
            "type": "string",
            "nullable": true,
            "description": "Error details if any, otherwise null"
          }
        }
      }
    }
  }
}
 