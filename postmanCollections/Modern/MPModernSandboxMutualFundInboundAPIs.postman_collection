										"exec": [
											"let codeChallenge = pm.request.url.query.get('code_challenge');\r",
											"pm.request.removeQueryParams('code_challenge');\r",
											"var sha256Hash =  CryptoJS.SHA256(codeChallenge).toString();\r",
											"var base64Hash = CryptoJS.enc.Utf8.parse(sha256Hash);\r",
											"var base64 = CryptoJS.enc.Base64.stringify(base64Hash);\r",
											"console.log(base64);\r",
											"pm.request.addQueryParams('code_challenge=' + base64);"
